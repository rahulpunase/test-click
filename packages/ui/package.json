    "lucide-react": "^0.469.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.1",
    "tailwind-merge": "^2.5.5",
    "tailwind-variants": "^0.2.1",
    "zod": "^4.3.6"
